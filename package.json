{
  "name": "photobooth",
  "version": "4.5.1",
  "description": "A Photobooth webinterface for Linux and Windows",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.6.0"
  },
  "scripts": {
    "build": "npm test",
    "lint:js": "node scripts/run-project-tests.cjs --syntax-only",
    "eslint": "npm run lint:js",
    "format": "npm-run-all --parallel format:*",
    "format:js": "prettier resources/js/*.js --write",
    "format:phpapi": "prettier api/{,*/**/}*.php --write --plugin=@prettier/plugin-php",
    "format:phplib": "prettier lib/*.php --write --plugin=@prettier/plugin-php",
    "format:phptest": "prettier test/*.php --write --plugin=@prettier/plugin-php",
    "format:css": "prettier resources/css/*.css --write",
    "test": "node scripts/run-project-tests.cjs",
    "test:browser": "node scripts/test-filter-stage-browser.mjs && node scripts/test-photo-receipt-browser.mjs",
    "watch": "npm run watch:pipe",
    "watch:pipe": "powershell -ExecutionPolicy Bypass -File ./scripts/watch-pipeline.ps1",
    "watch:php": "php scripts/run-tests.php --watch --heal"
  },
  "author": "Andreas Blaesius <andi@unlegacy-android.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhotoboothProject/photobooth.git"
  },
  "homepage": "https://photoboothproject.github.io",
  "bugs": {
    "url": "https://github.com/PhotoboothProject/photobooth/issues"
  },
  "keywords": [
    "photobooth",
    "gphoto2",
    "camera",
    "digicamcontrol",
    "photography",
    "raspberry pi",
    "wedding",
    "events"
  ],
  "dependencies": {
    "@andreasremdt/simple-translator": "^2.0.4",
    "font-awesome": "^4.7.0",
    "github-markdown-css": "^5.6.1",
    "gulp": "^4.0.2",
    "gulp-dart-sass": "^1.1.0",
    "jquery": "^3.7.1",
    "marked": "^9.1.6",
    "marvinj": "^1.0.0",
    "material-icons": "^1.13.12",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "onoff": "github:PhotoboothProject/onoff#master",
    "sass": "^1.78.0",
    "selectize": "^0.12.6",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "waypoints": "^4.0.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@prettier/plugin-php": "^0.20.1",
    "archiver": "^5.3.2",
    "colors": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-node": "^11.1.0",
    "git-tag-version": "^1.3.1",
    "gulp-babel": "^8.0.0",
    "prettier": "^3.3.3"
  }
}
